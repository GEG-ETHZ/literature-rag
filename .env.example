# The GEG deployment in geg-core-dev. Copy to .env; nothing here is secret.
# Terraform reads terraform/geg-core-dev.tfvars instead; the scripts read this file.
GOOGLE_CLOUD_PROJECT=geg-core-dev
GOOGLE_CLOUD_LOCATION=europe-west1
GCS_BUCKET_NAME=geg-core-dev-rag-own-publications
RAG_CORPUS_DISPLAY_NAME="GEG-Own-Publications"
RAG_CORPUS_DESCRIPTION="GEG publications, one PDF per DOI, uploaded with geg-rag-upload"
GCP_SECRET_ID=rag-own-publications-corpus-id
GEMINI_MODEL_NAME=gemini-2.5-flash
SERVICE_ACCOUNT_ID=rag-ingestor-sa-corpus-agent
CLOUD_FUNCTION_NAME=rag-own-publications-ingestor

# --- Vertex AI Agent Engine (corpus-only ADK agent) ---
# Same region as the corpus: europe-west1 serves Gemini and hosts RAG corpora.
AGENT_ENGINE_LOCATION=europe-west1
AGENT_MODEL_NAME=gemini-2.5-flash
# scripts/deploy_agent.py finds the deployed agent by this name and updates it in place.
AGENT_DISPLAY_NAME=GEG-Publication-Corpus-Agent
AGENT_STAGING_BUCKET_NAME=geg-publications-rag-agent-staging-bucket
# Rewritten by scripts/deploy_agent.py after each deploy.
AGENT_ENGINE_ID=projects/436056981716/locations/europe-west1/reasoningEngines/4185840766943232000
# 0: plain text with [n] citations and a "Source excerpts:" section; 1: JSON envelope.
AGENT_STRUCTURED_OUTPUT=0
AGENT_EXCERPT_MAX_CHARS=600
# The corpus the agent answers from, used directly so the deploy needs no Secret Manager read.
RAG_CORPUS=projects/436056981716/locations/europe-west1/ragCorpora/2842897264777625600
